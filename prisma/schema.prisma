generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum StaffRole {
  ADMIN
  STAFF
}

model StaffUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         StaffRole @default(STAFF)
  createdAt    DateTime  @default(now())
  otpCode      String?
  otpExpiresAt DateTime?
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  RESCHEDULED
  OTHER
}

enum SpaceChoice {
  terrasse
  salle
  vip
  privatisation_vip
}

model Reservation {
  id          String            @id @default(cuid())
  name        String
  phone       String
  email       String?
  date        String
  time        String
  guests      Int
  space       SpaceChoice
  message     String?
  status      ReservationStatus @default(PENDING)
  statusNote  String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model MenuDish {
  id           String   @id @default(cuid())
  name         String
  description  String
  price        Int
  category     String
  badge        String?
  spices       String[]
  isVegetarian Boolean  @default(false)
  isAvailable  Boolean  @default(true)
  sortOrder    Int      @default(0)
  image        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model LiveEvent {
  id          String   @id @default(cuid())
  title       String
  date        String
  time        String
  artist      String
  genre       String
  description String
  image       String?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteSetting {
  id        String   @id
  payload   Json
  updatedAt DateTime @updatedAt
}

model SiteImage {
  path      String   @id
  mime      String
  bytes     Bytes
  updatedAt DateTime @updatedAt
}
